# ===========================================================================
#  EngineVerse configuration
#  Copy to `.env` and edit. NEVER commit `.env`.
#  Everything below is self-hosted - no third-party service is required.
# ===========================================================================

# 32+ random bytes, used for session MACs, CSRF tokens, and authenticator seals.
# Rotating it signs everyone out and makes existing authenticator seals unreadable.
# Generate:  python3 -c "import secrets;print(secrets.token_hex(32))"
ENGINEVERSE_SECRET=

# Where the app is served from (canonical URLs, cookie Secure flag).
ENGINEVERSE_SITE_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup):
ENGINEVERSE_DB_PATH=./data/engineverse.sqlite
# PostgreSQL (production, billions of rows - see db/postgres/README.md):
# ENGINEVERSE_DB_URL=postgresql://engineverse:secret@127.0.0.1:5432/engineverse

# --- Outbound mail ---------------------------------------------------------
# Empty means this instance has no mail transport. Without it, password reset
# cannot deliver a link, so self-service reset is reported as unavailable rather
# than the link being shown in the page -- showing it would let anyone request a
# reset for a victim's address and read the live link back out of the response.
# ENGINEVERSE_SMTP_URL=smtp://user:password@mail.internal:587/?starttls=1
# ENGINEVERSE_MAIL_FROM=EngineVerse <no-reply@example.org>
# When this is set, Settings can email a confirmation link. The link is not
# shown in the page. Without it, addresses stay unconfirmed and sign-in works.

# DEVELOPMENT ONLY. Shows the reset link in the page instead of emailing it.
# Refused outright when ENGINEVERSE_ENV=production. Leave this unset anywhere a
# real user can reach the site.
# ENGINEVERSE_REVEAL_RESET_TOKEN=0

# --- Code execution --------------------------------------------------------
# Development default. Production refuses auto, python and java: those run
# learner code on this server. Use disabled, or judge0 with a URL you operate.
# auto   -> use the Java sandbox when a JDK is available, else the built-in runner
# python -> force the built-in runner
# java   -> force the Java sandbox service (requires JAVA_HOME)
# disabled -> refuse every submission
# judge0 -> forward to a self-hosted Judge0 API
ENGINEVERSE_JUDGE=auto
ENGINEVERSE_JUDGE_TIMEOUT_MS=5000
ENGINEVERSE_JUDGE_MEMORY_KB=524288
# ENGINEVERSE_JUDGE0_URL=http://127.0.0.1:2358
# ENGINEVERSE_JUDGE0_KEY=

# Java sandbox (only needed for ENGINEVERSE_JUDGE=java)
# JAVA_HOME=/usr/lib/jvm/java-21
# ENGINEVERSE_JAVA_SANDBOX_JAR=./sandbox-java/target/engineverse-sandbox.jar

# --- AI tutor --------------------------------------------------------------
# Leave empty to run in grounded-retrieval mode (answers are assembled only
# from EngineVerse content, so it can never invent syllabus facts).
# ENGINEVERSE_AI_KEY=
# ENGINEVERSE_AI_URL=

# Leave unset. X-Forwarded-For is ignored unless this is on, and even then only
# when the TCP peer is loopback or private. Do not turn it on because a compose
# port is published on 127.0.0.1; there is no proxy in that file. A public peer
# that sends the header is still the client.
# ENGINEVERSE_TRUST_PROXY=0

HOST=0.0.0.0
PORT=8000
