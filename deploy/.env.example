# EngineVerse deployment configuration.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is git-ignored. Never commit real values.

# Keys the session token digests, the CSRF HMAC and the signed flash cookie.
# Must be at least 32 random bytes. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this invalidates every session and signs everyone out.
ENGINEVERSE_SECRET=

# Password for the PostgreSQL superuser created on first boot.
POSTGRES_PASSWORD=

# The public HTTPS origin. Used to build absolute URLs in the sitemap,
# certificates and the PWA manifest.
SITE_URL=https://engineverse.local

# Which judge to use: auto | python | java | judge0
#   auto    - use the Java sandbox if it is available, else the local runner
#   java    - require the sandbox; Java problems fail otherwise
#   python  - the local runner only (Java problems report unsupported_language)
JUDGE=auto
