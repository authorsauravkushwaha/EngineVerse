# EngineVerse deployment configuration.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is git-ignored. Never commit real values. Never paste them into
# an issue, a chat, or a log.

# Keys the session token digests, the CSRF HMAC and the signed flash cookie.
# Must be at least 32 random characters and must not be the development
# fallback. Generate one with:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating this invalidates every session and makes authenticator seals unreadable.
# scripts/create_admin.py --replace clears the super administrator's seal.
ENGINEVERSE_SECRET=

# Password for the PostgreSQL superuser created on first boot. Use only
# A-Za-z0-9_- so it survives the connection URL. At least 16 characters.
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# Password for engineverse_app, the login the web process uses. Same character
# rule. This role can read and write rows. It cannot create tables.
APP_DB_PASSWORD=

# The public HTTPS origin. Cookie Secure follows this. http:// is refused in
# production. SITE_URL is accepted as an alias when this is unset.
ENGINEVERSE_SITE_URL=https://engineverse.example

# --- Sign-in codes and outbound mail ---------------------------------------
# "disabled" (the default) is password-only sign-in: the password is checked
# against a scrypt hash and the session cookie is HttpOnly/SameSite, with
# temporary lockout after repeated failures. No transport is needed.
#
# "required" asks for a fresh six-digit code after every password sign-in and
# needs ENGINEVERSE_SMTP_URL or ENGINEVERSE_SMS_URL below. Production refuses
# to start in that mode without a transport, because a deployment with nowhere
# to send the code would lock every learner out of their own account.
#
# Accounts that want a second factor do not need this mode: enrol an
# authenticator app under Settings and that account is asked for a code.
ENGINEVERSE_LOGIN_OTP=disabled

# Outbound mail, through the standard library's smtplib - no hosted service.
# Empty means this instance has no mail transport, so sign-in codes and
# password-reset links cannot be delivered. For Gmail, use a dedicated account
# and a two-step-verification app password, not the account password; URL-encode
# the @ and hyphens. Keep the value in the deployment secret store, never in
# Git or a ticket.
# ENGINEVERSE_SMTP_URL=smtps://engineverse%40example.com:xxxx%2Dxxxx%2Dxxxx%2Dxxxx@smtp.gmail.com:465/?starttls=0
# ENGINEVERSE_MAIL_FROM=EngineVerse <no-reply@example.org>

# An SMS gateway operated by the deployment, not a hosted provider. It receives
# POST JSON {"to":"+...","body":"..."}; a userinfo password becomes an
# Authorization: Bearer header and is stripped from the URL. Production refuses
# a plain-http URL here.
# ENGINEVERSE_SMS_URL=https://gateway.internal/messages

# Which judge to use. Production refuses auto, python and java: those run
# learner code on this server, and a subprocess is not a separate container.
#   disabled  - run nothing (the default)
#   judge0    - forward to a Judge0 you deployed yourself; also set
#               ENGINEVERSE_JUDGE0_URL. This compose file does not verify
#               that host's isolation.
ENGINEVERSE_JUDGE=disabled

# Leave unset. This compose file publishes the app on 127.0.0.1 and does not
# run a proxy. Setting ENGINEVERSE_TRUST_PROXY while any other client can reach
# the process lets that client choose the address used for rate limits.
# ENGINEVERSE_TRUST_PROXY=0
# ENGINEVERSE_JUDGE0_URL=http://judge0.internal:2358
# ENGINEVERSE_JUDGE0_KEY=
